# Rendered by Terraform. Secrets are injected as environment variables:
# GITHUB_APP_PRIVATE_KEY, GITHUB_APP_WEBHOOK_SECRET, GITHUB_OAUTH_CLIENT_SECRET,
# POLICYBOT_SESSIONS_KEY. IDs arrive as GITHUB_APP_INTEGRATION_ID and
# GITHUB_OAUTH_CLIENT_ID.
server:
  address: "0.0.0.0"
  port: 8080
  public_url: "${public_url}"

logging:
  text: false
  level: info

github:
  web_url: "https://github.com"
  v3_api_url: "https://api.github.com"
  v4_api_url: "https://api.github.com/graphql"

options:
  status_check_context: "${status_check_context}"
